# 环境变量配置示例 — 复制此文件为 .env 并按需修改

# 项目名称
PROJECT_NAME=电商智能客服系统
VERSION=1.0.0
DEBUG=true

# 服务器
HOST=0.0.0.0
PORT=8000

# CORS (逗号分隔)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MySQL 数据库 (可选 — 不配置则使用内存模式)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/ecommerce_cs?charset=utf8mb4

# Redis (可选)
REDIS_URL=redis://localhost:6379/0

# JWT 密钥 (生产环境请务必修改为随机字符串)
SECRET_KEY=change-me-to-a-random-secret

# LLM 配置 — DeepSeek
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-v4-flash
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Embedding 配置 — 千问 DashScope
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v1
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=knowledge_base

# 日志级别
LOG_LEVEL=INFO
