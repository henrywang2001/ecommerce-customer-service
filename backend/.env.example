# 环境变量配置示例 — 复制此文件为 .env 并按需修改
# 注意：.env 已被 .gitignore 排除，绝不会被提交到 Git

# 项目名称
PROJECT_NAME=电商智能客服系统
VERSION=1.0.0
DEBUG=true

# 服务器
HOST=0.0.0.0
PORT=8000

# CORS (逗号分隔)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# MySQL 数据库 (可选 — 不配置则使用内存模式)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/ecommerce_cs?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://root:password@localhost:3306/ecommerce_cs?charset=utf8mb4

# Redis (可选)
REDIS_URL=redis://localhost:6379/0

# JWT 配置 (生产环境请务必修改为随机字符串，占位值会被运行时随机密钥覆盖)
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 全站鉴权开关：True 时所有接口需 Bearer JWT；False 时 demo 模式免鉴权
REQUIRE_AUTH=true

# LLM 配置 — DeepSeek
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-v4-flash
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Embedding 配置 — 千问 DashScope
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v1
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1536

# Provider 抽象层 — 厂商标识：deepseek / dashscope / chroma
LLM_PROVIDER=deepseek
EMBEDDING_PROVIDER=dashscope
VECTORSTORE_PROVIDER=chroma

# ChromaDB 向量存储 (默认基于 backend 目录的绝对路径)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=knowledge_base

# RAG 检索
RAG_TOP_K=5

# 意图识别
INTENT_THRESHOLD=0.6

# 会话生命周期治理
SESSION_MAX_COUNT=200
SESSION_TTL=86400
HISTORY_TURNS=6

# 数据库连线池
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# 上游 LLM/Embedding 弹性（重试 + 熔断 + 并发控制）
UPSTREAM_LLM_MAX_CONCURRENCY=20
UPSTREAM_EMBEDDING_MAX_CONCURRENCY=20
UPSTREAM_MAX_RETRIES=3
UPSTREAM_RETRY_BASE_DELAY=0.5
UPSTREAM_RETRY_MAX_DELAY=8.0
UPSTREAM_LLM_CB_FAILURES=5
UPSTREAM_LLM_CB_COOLDOWN=30.0
UPSTREAM_EMBEDDING_CB_FAILURES=5
UPSTREAM_EMBEDDING_CB_COOLDOWN=30.0
# 昂贵接口（/send、/send_stream、/agent/process）每分钟上限
RATE_LIMIT_HEAVY_MAX_REQUESTS=30

# 日志 (默认基于 backend 目录的绝对路径)
LOG_LEVEL=INFO
LOG_DIR=./logs

# Langfuse 可观测性 (可选 — 未配置时自动降级 no-op)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=1.0.0
